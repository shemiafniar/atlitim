# Public site URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave these empty only for local `npm run dev` demo mode.
# Production must set both. Production never falls back to fictional businesses.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for admin writes, image uploads and owner edits when Supabase is connected.
# Never expose this key in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to use /admin when Supabase Auth is configured.
ADMIN_EMAILS=you@example.com

# Signs the local demo admin cookie. Not used for production admin login.
ADMIN_SESSION_SECRET=

# Local demo password only. Ignored when Supabase is configured and ignored in production.
DEMO_ADMIN_PASSWORD=atlitim-demo

# Optional analytics. Leave empty to no-op.
# Supported client flag: plausible, umami, or any non-empty value that enables /api/events.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Optional webhook that receives allowed product events.
ANALYTICS_WEBHOOK_URL=
